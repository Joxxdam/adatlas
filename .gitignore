# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
application_default_credentials.json
*service-account*.json
gcp-credentials*.json
google-credentials*.json
credentials*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.zip
*.tmp
*.bak
.next-dev.stdout.log
.next-dev.stderr.log

# env files (can opt-in for committing if needed)
.env*
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated local assets
public/generated-ads/*
!public/generated-ads/.gitkeep
public/generated-product-images/*
!public/generated-product-images/.gitkeep
public/processed-products/*
!public/processed-products/.gitkeep
public/uploaded-source-images/*
!public/uploaded-source-images/.gitkeep
data/review-analysis-cache.json
public/background-images/*
!public/background-images/.gitkeep
public/extracted/*
!public/extracted/.gitkeep

# large local background catalog runtime data
/background-library/import/*
!/background-library/import/.gitkeep
/background-library/originals/*
!/background-library/originals/.gitkeep
/background-library/processed/*
!/background-library/processed/.gitkeep
/background-library/thumbnails/*
!/background-library/thumbnails/.gitkeep
/background-library/review/*
!/background-library/review/.gitkeep
/background-library/jobs/*
!/background-library/jobs/.gitkeep
/background-library/logs/*
!/background-library/logs/.gitkeep
/background-library/manifests/*
!/background-library/manifests/schema.json
!/background-library/manifests/.gitkeep

# local creative quality benchmark source images
data/creative-benchmarks/desired-quality/

# local store analysis results
data/store-analysis/*
!data/store-analysis/.gitkeep

# resumable creative-generation runtime jobs
data/creative-generation-jobs/*
!data/creative-generation-jobs/.gitkeep
data/creative-generation-master-scenes/*
!data/creative-generation-master-scenes/.gitkeep
public/generated-master-scenes/*
!public/generated-master-scenes/.gitkeep

# generated creative asset registry (local JSON MVP storage)
data/creative-assets/*
!data/creative-assets/.gitkeep

# video collaboration MVP runtime data and uploaded files
data/video-collaboration/*
!data/video-collaboration/.gitkeep
public/video-collaboration/*
!public/video-collaboration/.gitkeep

# local Codex advertiser threads and AI-native final creatives
.data/codex/
/.data/ad-copy/
/.data/generated/
/.data/creative-generation/
/.data/creative-archive/index.json
/.data/site-candidates/
/.data/creative-plan-cache/
