# Server-side keys only. Never expose these values through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
# Paid GPT Image calls are opt-in. Tests, builds, and analysis never toggle this flag.
PAID_IMAGE_GENERATION_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Legacy paid image routes stay off until a separate provider-selection UI records
# per-request consent. OPENAI_API_KEY by itself never enables image generation.
ADATLAS_IMAGE_GENERATION_ENABLED=false
ADATLAS_IMAGE_MODEL=gpt-image-1.5
ADATLAS_IMAGE_QUALITY=high
ADATLAS_IMAGE_SIZE=1024x1024
# Legacy scene-generator setting. The default ZIP-reference path does not use it.
ADATLAS_MAX_SCENE_CANDIDATES=1
ADATLAS_CREATIVE_COUNT=6
ADATLAS_FAST_CREATIVE_MODE=true
ADATLAS_CREATIVE_CONCURRENCY=3
# 여러 상품 작업이 겹쳐도 로컬 Codex 생성·검수는 전역 3개까지만 실행합니다.
ADATLAS_CODEX_MAX_PARALLEL_RUNS=3
ADATLAS_AUTO_REVISION_LIMIT=1
ADATLAS_BACKGROUND_GROUP_QA=false
ADATLAS_CODEX_PLANNER_REASONING=medium
ADATLAS_CODEX_IMAGE_REASONING=low
ADATLAS_MAX_CREATIVES_PER_PRODUCT=6
ADATLAS_CREATIVE_RETRIES=1
ADATLAS_IMAGE_MAX_RETRIES=1
# Legacy optional scene comparison. Final ZIP-reference QA always compares the
# selected advertisement structure and URL product references through Codex.
ADATLAS_SCENE_IDENTITY_VISION_ENABLED=true
# Optional server-side model override for legacy copy helpers.
OPENAI_TEXT_MODEL=gpt-5.6-sol
CREATIVE_COPY_MODEL=gpt-5.6-sol
# Optional model override for review-image OCR and visual analysis.
OPENAI_VISION_MODEL=gpt-5.6-sol

# Default staged ZIP-reference edit engine. codex_local uses the installed Codex
# CLI and current ChatGPT login; OPENAI_API_KEY is removed from that child process.
ADATLAS_CODEX_MODEL=gpt-5.6-sol
ADATLAS_CODEX_THREAD_MAX_TURNS=60
ADATLAS_CODEX_PLANNING_TIMEOUT_MS=180000
ADATLAS_CODEX_IMAGE_TIMEOUT_MS=720000
ADATLAS_CODEX_VALIDATION_TIMEOUT_MS=150000
# Video planning uses the OpenAI Responses API. OPENAI_API_KEY is required on
# the server. Set codex-local only for an explicit local run; provider failures
# never trigger an automatic cross-provider fallback.
VIDEO_PLANNING_PROVIDER=openai-api
VIDEO_PLANNING_ANALYSIS_MODEL=gpt-5.6-luna
VIDEO_PLANNING_CONCEPT_MODEL=gpt-5.6-terra
VIDEO_PLANNING_SCRIPT_MODEL=gpt-5.6-terra
VIDEO_PLANNING_ANALYSIS_TIMEOUT_MS=45000
VIDEO_PLANNING_CONCEPT_TIMEOUT_MS=60000
VIDEO_PLANNING_SCRIPT_TIMEOUT_MS=90000
VIDEO_PLANNING_LOGS=true
# Local Codex model used for product analysis, concepts, and detailed scripts.
VIDEO_PLANNING_CODEX_MODEL=gpt-5.6-sol
VIDEO_PLANNING_CODEX_TIMEOUT_MS=180000
# Paid image-generation routes remain separately protected by this switch.
# VIDEO_PLANNING_PROVIDER=openai-api does not depend on or enable this flag.
ADATLAS_PAID_API_EXPLICIT_ENABLED=false
ADATLAS_OPENAI_VALIDATION_TIMEOUT_MS=120000
# Native creative routes accept browser requests only through localhost. An
# internal worker may use this optional server-side token instead.
ADATLAS_INTERNAL_GENERATION_TOKEN=
# A running result with no in-memory runner is recovered after this interval.
ADATLAS_CREATIVE_STALE_MS=720000

# Daily auto-production. Keep the token server-side; local same-origin browser
# requests do not need it. External OS schedulers may send it as an internal header.
ADATLAS_AUTO_PRODUCTION_TOKEN=
ADATLAS_AUTO_PRODUCTION_BASE_URL=http://127.0.0.1:3000
ADATLAS_AUTO_PRODUCTION_STALE_MS=720000

# Optional Crema Review API connection. Uses OAuth2 client credentials on api.cre.ma.
# Without these values the existing detail-page creative flow remains available.
CREMA_APP_ID=
CREMA_SECRET=

# Optional Google BigQuery read-only candidate discovery.
# Authentication uses local Application Default Credentials; never place credential JSON here.
BIGQUERY_PROJECT_ID=first-project-394906
BIGQUERY_LOCATION=US
BIGQUERY_MAX_BYTES_BILLED=1000000000
BIGQUERY_QUERY_TIMEOUT_MS=30000
# Required in production for internal BigQuery/candidate APIs. Configure this only on the server
# or have an authenticated reverse proxy inject the matching header; never expose it as NEXT_PUBLIC_*.
ADATLAS_INTERNAL_API_TOKEN=

# Optional precision background-removal provider.
# Without this key AdAtlas uses the conservative local fallback and rejects low-quality results.
REMOVE_BG_API_KEY=

# Optional free Pexels search. The key stays server-side; browser code never receives it.
PEXELS_API_KEY=
PEXELS_MODE=search-only
PEXELS_BULK_PERMISSION_CONFIRMED=false

# Optional Meta Marketing API integration. All external reads and writes are OFF by default.
# Never expose tokens or app secrets through NEXT_PUBLIC_* variables.
META_GRAPH_API_VERSION=
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_ACCESS_TOKEN=
META_ALLOWED_AD_ACCOUNT_IDS=
META_ADVERTISER_ASSET_MAP_JSON={}
META_ADSET_BUDGET_BY_ACCOUNT_JSON={}
META_READ_ENABLED=false
META_WRITE_ENABLED=false
META_DRY_RUN=true
META_INSIGHTS_SCHEDULER_ENABLED=false
META_INSIGHTS_INTERVAL_MINUTES=60
META_DEFAULT_ADSET_DAILY_BUDGET_USD=5
META_MAX_ADS_PER_REQUEST=6
META_REQUEST_TIMEOUT_MS=15000
HOOK_MIN_IMPRESSIONS=1000
HOOK_MIN_OUTBOUND_CLICKS=30
HOOK_MIN_PURCHASES=3
HOOK_MIN_SPEND=20

# Optional local-only image generation. No model is downloaded automatically.
LOCAL_IMAGE_PROVIDER=comfyui
COMFYUI_URL=http://127.0.0.1:8188/
COMFYUI_WORKFLOW_PATH=
COMFYUI_OUTPUT_NODE_ID=
COMFYUI_POSITIVE_PROMPT_NODE_ID=
COMFYUI_NEGATIVE_PROMPT_NODE_ID=
COMFYUI_SEED_NODE_ID=
COMFYUI_CONCURRENCY=1
