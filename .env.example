# Server-side keys only. Never expose these values through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
# Paid GPT Image calls are opt-in. Tests, builds, and analysis never toggle this flag.
PAID_IMAGE_GENERATION_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-1.5
# New master-scene pipeline. The legacy PAID_IMAGE_GENERATION_ENABLED flag remains supported.
ADATLAS_IMAGE_GENERATION_ENABLED=true
ADATLAS_IMAGE_MODEL=gpt-image-1.5
ADATLAS_IMAGE_QUALITY=high
ADATLAS_IMAGE_SIZE=1024x1024
ADATLAS_MAX_SCENE_CANDIDATES=1
ADATLAS_CREATIVE_COUNT=6
ADATLAS_CREATIVE_CONCURRENCY=2
ADATLAS_CREATIVE_RETRIES=1
ADATLAS_IMAGE_MAX_RETRIES=1
# Optional server-side visual comparison of generated scenes and product references.
ADATLAS_SCENE_IDENTITY_VISION_ENABLED=true
# Optional server-side model override for H01-H08 copy generation.
OPENAI_TEXT_MODEL=gpt-5.6-sol
CREATIVE_COPY_MODEL=gpt-5.6-sol
# Optional model override for review-image OCR and visual analysis.
OPENAI_VISION_MODEL=gpt-5.6-sol

# AI-native final-ad engine. codex_local uses the installed Codex CLI and the
# current ChatGPT login; OPENAI_API_KEY is removed from that child process.
ADATLAS_CODEX_MODEL=gpt-5.6-sol
ADATLAS_CODEX_THREAD_MAX_TURNS=60
ADATLAS_CODEX_IMAGE_TIMEOUT_MS=300000
ADATLAS_CODEX_VALIDATION_TIMEOUT_MS=150000
# Paid OpenAI fallback is never automatic. It works only when the user selects
# openai_api and explicitly enables this server-side switch.
ADATLAS_PAID_API_EXPLICIT_ENABLED=false
ADATLAS_OPENAI_VALIDATION_TIMEOUT_MS=120000

# Optional Crema Review API connection. Uses OAuth2 client credentials on api.cre.ma.
# Without these values the existing detail-page creative flow remains available.
CREMA_APP_ID=
CREMA_SECRET=

# Optional Google BigQuery read-only candidate discovery.
# Authentication uses local Application Default Credentials; never place credential JSON here.
BIGQUERY_PROJECT_ID=first-project-394906
BIGQUERY_LOCATION=US
BIGQUERY_MAX_BYTES_BILLED=1000000000
BIGQUERY_QUERY_TIMEOUT_MS=30000
# Required in production for internal BigQuery/candidate APIs. Configure this only on the server
# or have an authenticated reverse proxy inject the matching header; never expose it as NEXT_PUBLIC_*.
ADATLAS_INTERNAL_API_TOKEN=

# Optional precision background-removal provider.
# Without this key AdAtlas uses the conservative local fallback and rejects low-quality results.
REMOVE_BG_API_KEY=

# Optional free Pexels search. The key stays server-side; browser code never receives it.
PEXELS_API_KEY=
PEXELS_MODE=search-only
PEXELS_BULK_PERMISSION_CONFIRMED=false

# Optional local-only image generation. No model is downloaded automatically.
LOCAL_IMAGE_PROVIDER=comfyui
COMFYUI_URL=http://127.0.0.1:8188/
COMFYUI_WORKFLOW_PATH=
COMFYUI_OUTPUT_NODE_ID=
COMFYUI_POSITIVE_PROMPT_NODE_ID=
COMFYUI_NEGATIVE_PROMPT_NODE_ID=
COMFYUI_SEED_NODE_ID=
COMFYUI_CONCURRENCY=1
