# Server-side keys only. Never expose these values through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
# Paid GPT Image calls are opt-in. Tests, builds, and analysis never toggle this flag.
PAID_IMAGE_GENERATION_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional model override for review-image OCR and visual analysis.
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optional Crema Review API connection. Uses OAuth2 client credentials on api.cre.ma.
# Without these values the existing detail-page creative flow remains available.
CREMA_APP_ID=
CREMA_SECRET=

# Optional precision background-removal provider.
# Without this key AdAtlas uses the conservative local fallback and rejects low-quality results.
REMOVE_BG_API_KEY=

# Optional free Pexels search. The key stays server-side; browser code never receives it.
PEXELS_API_KEY=
PEXELS_MODE=search-only
PEXELS_BULK_PERMISSION_CONFIRMED=false

# Optional local-only image generation. No model is downloaded automatically.
LOCAL_IMAGE_PROVIDER=comfyui
COMFYUI_URL=http://127.0.0.1:8188/
COMFYUI_WORKFLOW_PATH=
COMFYUI_OUTPUT_NODE_ID=
COMFYUI_POSITIVE_PROMPT_NODE_ID=
COMFYUI_NEGATIVE_PROMPT_NODE_ID=
COMFYUI_SEED_NODE_ID=
COMFYUI_CONCURRENCY=1
